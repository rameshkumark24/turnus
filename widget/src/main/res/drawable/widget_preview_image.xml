        android:fillColor="#151E24"
        android:pathData="M8,0h164a8,8 0 0 1 8,8v64a8,8 0 0 1 -8,8H8a8,8 0 0 1 -8,-8V8a8,8 0 0 1 8,-8z" />

    <!-- "Night", as a solid bar: real text in a preview would need translating. -->
