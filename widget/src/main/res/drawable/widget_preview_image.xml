<?xml version="1.0" encoding="utf-8"?>
<!--
  A drawable, not only a previewLayout.

  previewLayout is API 31+ and launchers are free to ignore it — Funtouch does,
  and falls back to the initialLayout, which for Glance is a blank loading
  spinner. A widget previewed as an empty white box is a widget nobody adds.
  A drawable is understood by every launcher on every version.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="80dp"
    android:viewportWidth="180"
    android:viewportHeight="80">

