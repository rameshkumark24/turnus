<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is deliberately 0. The system caps it at half an hour and
  wakes the device to honour it, which for a calendar that changes at midnight
  is a lot of battery for nothing. The app, the daily worker and the boot
  receiver push updates instead, at the moments the content actually changes.

  initialLayout is our own placeholder rather than Glance's default loading
  layout. Several launchers — Funtouch among them — render initialLayout as the
  picker preview and ignore previewImage and previewLayout entirely, so the
  default showed a blank white spinner where the widget should be. It is also
  what a freshly placed widget shows for its first frame, so a plausible layout
  beats a loading circle in both places.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="70dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_preview"
    android:initialLayout="@layout/widget_preview" />
