<?xml version="1.0" encoding="utf-8"?>
<!--
  Four bars: two worked, two off. The 2-on-2-off motif, which reads as a
  rotation rather than as a generic calendar page.

  Every bar sits inside the 66dp circle that an adaptive icon guarantees on
  every mask shape: the run is 60dp wide and 26dp tall, centred, so its
  farthest corner is 32.7dp from the centre of the 108dp canvas.

  This is load-bearing, not tidiness. The first version of this icon ran the
  fourth bar out to x=95 so it was cut off, to say the pattern keeps going.
  A launcher does not cut it artfully — a circular mask deletes that bar
  outright, leaving two worked days and one off, and it pulls the whole mark
  visibly left of centre. The motif has to survive the mask, so the run is
  centred and complete, and nothing relies on being clipped to make its point.

  Anything added here must keep 4w + 3g = 60 and h = 26, or be re-checked
  against sqrt((width/2)^2 + (height/2)^2) <= 33.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,41 h6 a3,3 0 0 1 3,3 v20 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-20 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M43,41 h6 a3,3 0 0 1 3,3 v20 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-20 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.38"
        android:pathData="M59,41 h6 a3,3 0 0 1 3,3 v20 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-20 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.38"
        android:pathData="M75,41 h6 a3,3 0 0 1 3,3 v20 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-20 a3,3 0 0 1 3,-3 z" />
</vector>
