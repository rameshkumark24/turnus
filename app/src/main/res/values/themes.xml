<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theme; this only styles the window before
         the first frame, so it must match the app background to avoid a flash. -->
    <style name="Theme.Turnus" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
