<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for at runtime, after the grid is populated. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Alarms are dropped by a reboot and the system does not tell the app, so
      without this a reminder schedule silently stops after a restart.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM. The latter is auto-granted but
      Play restricts it to apps whose core purpose is alarms or calendars, and
      leaning on it invites a policy rejection. This one the user grants, and
      the scheduler falls back to an inexact alarm when they have not — a
      reminder a few minutes late beats no reminder.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".TurnusApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Turnus">

        <!--
          Required by the ads SDK, which crashes at startup if it is missing.
          The value comes from a build-type placeholder: debug always gets
          Google's test id, release gets the real one from local.properties.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
          The SDK otherwise starts fetching on first Activity launch, before the
          user has been asked anything. Consent decides whether ads may be
          requested at all, so initialisation waits for it.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Turnus"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Serves the exported .ics to whichever app the user picks from the
          share sheet. Not exported: access is granted per-URI, per-share, and
          expires — no other app can enumerate or read these files uninvited.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Not exported: only this app's own alarms may trigger it. -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Sent by several manufacturers in place of the standard action. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!--
                  A reminder is converted from a wall-clock time to an instant
                  once, when it is scheduled. Moving the clock or the zone
                  leaves a window of alarms that no longer mean the time they
                  were set for, and Android reschedules none of them.
                -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
